{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cryptonetpaybot",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-04",
	"assets": {
		"directory": "./dist/",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"cache": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"placement": {
		"mode": "smart"
	},
	"d1_databases": [
    {
      "binding": "DB",
      "database_name": "cryptonetpaybot",
      "database_id": "e15a4ecd-795c-4700-86a4-de1bfeff3660"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BROADCAST_QUEUE",
        "queue": "broadcast-queue"
      }
    ],
    "consumers": [
      {
        "queue": "broadcast-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
