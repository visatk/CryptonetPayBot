{
	"name": "cryptonetpaybot",
	"version": "0.0.0",
	"private": true,
	"description": "Cryptonet Pay is a payment system based on apirone api that allows you to accept payments in crypto and transfer coins to users using our API",
	"keywords": [
		"crypto"
	],
	"homepage": "https://github.com/visatk/CryptonetPayBot#readme",
	"bugs": {
		"url": "https://github.com/visatk/CryptonetPayBot/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/visatk/CryptonetPayBot.git"
	},
	"license": "MIT",
	"author": "visatk",
	"type": "module",
	"main": "index.ts",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"preview": "npm run build && vite preview",
		"deploy": "npm run cf-typegen && npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:remote": "wrangler d1 migrations apply cryptonetpaybot --remote"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.0",
		"@tailwindcss/vite": "^4.3.3",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.0",
		"lucide-react": "^1.28.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router-dom": "^7.18.2",
		"sonner": "^2.0.7",
		"web-push": "^3.6.7",
		"tailwindcss": "^4.3.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.50.0",
		"@types/telegram-web-app": "^9.6.0",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"drizzle-kit": "^0.31.10",
		"monetag-tg-sdk": "latest",
		"oxlint": "^1.71.0",
		"typescript": "~6.0.2",
		"vite": "^8.1.1",
		"wrangler": "4.119.0"
	}
}
